# Copy to .env (same folder) and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Defaults, change only if needed:
# DATABASE_URL=postgresql+psycopg://advisor:advisor@localhost:5433/advisor
# EMBEDDING_MODEL=openai/text-embedding-3-small
# CHUNKER=provision        (provision | fixed; fixed is the naive baseline for the evaluation)
# CHUNK_SIZE=1000          (fixed chunker only)
# CHUNK_OVERLAP=150        (fixed chunker only)
# CANDIDATES=24            (Passages fetched per search before the cap or the merge)
# API_HOST=127.0.0.1
# API_PORT=8010
# TOP_K=6
# MAX_PER_SOURCE=0   (per-Source cap; off by default, see docs/EVALUATION.md)
# SEARCH_STRATEGY=vector   (vector | hybrid; the default when a question does not choose one)
# KEYWORD_WEIGHT=0.5       (weight of keyword ranks in hybrid search)

# SCREENING=true           (the Pre-Check's screening of every question, ADR 0007)
# SCREENING_MODEL=openai/gpt-6-luna
# The Operator role is granted to an existing account with a command, not a setting (ADR 0006):
#   uv run compliance-advisor-accounts operator grant <email>
# LOG_FORMAT=json          (json | text)
# UPDATE_RUNS=false        (nightly Update Run inside the backend)
# UPDATE_HOUR=3            (UTC)
# Rate limits: config/limits.yaml.
# TRUST_X_FORWARDED_FOR=false  (true only behind a reverse proxy that sets the header)
# COOKIE_SECURE=false      (true when served over HTTPS)

# Answer Models offered in the interface: config/models.yaml (the first is the default).
